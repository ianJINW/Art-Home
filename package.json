{
  "name": "art-home",
  "version": "1.0.0",
  "private": true,
  "description": "A digital platform for discovering and managing art collections.",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1",
    "rimraf": "^5.0.0"
  },
  "scripts": {
    "build": "concurrently --names \"FE,BE\" --prefix-colors \"cyan,magenta\" \"npm run build --prefix client\" \"npm run build --prefix server\"",
    "start": "concurrently --names \"FE,BE\" --prefix-colors \"red,blue\" \"npm start --prefix client\" \"npm start --prefix server\"",
    "dev": "concurrently --names \"FE,BE\" --prefix-colors \"green,magenta\" \"npm run dev --prefix client\" \"npm run dev --prefix server\"",
    "test": "concurrently --names \"FE,BE\" --prefix-colors \"gray,white\" \"npm test --prefix client\" \"npm test --prefix server\"",
    "install-all": "concurrently --names \"FE,BE\" --prefix-colors \"green,cyan\" \"npm install --prefix client\" \"npm install --prefix server\"",
    "update": "concurrently --names \"FE,BE\" --prefix-colors \"blue,yellow\" \"npm update --prefix client\" \"npm update --prefix server\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ianJINW/Art-Home.git"
  },
  "license": "ISC"
}